# NEAR AI Cloud — get a key at https://nearbuilders.org/dashboard ($10 hackathon credits)
# Never commit the real .env; never paste the key into chats, repos or the UI.
NEARAI_API_KEY=
NEAR_BASE_URL=https://cloud-api.near.ai/v1
NEAR_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# Telemetry stack (docker compose up -d)
JAEGER_URL=http://localhost:16686
OTEL_COLLECTOR_URL=http://localhost:4318
PROM_URL=http://localhost:9090

PORT=3000

# NEAR AI attestation + reply-signature checks (attestation.js)
#   strict (default): any failed check stops the triage before evidence is sent
#   warn: show failures in the panel but continue   off: local mode, no checks (panel says so)
ATTESTATION_MODE=strict

# Model call tuning. Pick open-weight models NEAR runs in its own TEE (they appear in
# the attestation report); proxied anthropic/openai/google models are not private
# end to end and fail the attestation check. Reasoning models (e.g. z-ai/glm-5.3-flash)
# can take minutes on a full incident.
NEAR_TIMEOUT_MS=150000
# NEAR_EXTRA_BODY={"enable_thinking":false,"chat_template_kwargs":{"enable_thinking":false}}
